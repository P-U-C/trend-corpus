{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trend manifest",
  "type": "object",
  "required": ["id", "title", "status", "schema_version", "objects"],
  "additionalProperties": true,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "title": {"type": "string"},
    "status": {"type": "string", "enum": ["emerging", "growing", "peak_hype", "post_peak"]},
    "schema_version": {"type": "integer", "minimum": 1},
    "objects": {
      "type": "object",
      "required": ["sources", "claims", "entities", "events", "theses", "decision-packets", "watchlists"],
      "properties": {
        "sources": {"type": "string"},
        "claims": {"type": "string"},
        "entities": {"type": "string"},
        "events": {"type": "string"},
        "theses": {"type": "string"},
        "decision-packets": {"type": "string"},
        "watchlists": {"type": "string"}
      }
    }
  }
}

