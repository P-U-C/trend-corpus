{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source",
  "type": "object",
  "required": ["id", "type", "title", "url", "accessed_at", "schema_version"],
  "properties": {
    "id": {"type": "string", "pattern": "^src_"},
    "type": {"type": "string"},
    "title": {"type": "string"},
    "url": {"type": "string"},
    "accessed_at": {"type": "string"},
    "schema_version": {"type": "integer"}
  }
}

