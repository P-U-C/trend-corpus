{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claim",
  "type": "object",
  "required": ["id", "claim", "category", "source_ids", "date_of_evidence", "confidence", "schema_version"],
  "properties": {
    "id": {"type": "string", "pattern": "^clm_"},
    "claim": {"type": "string"},
    "category": {"type": "string"},
    "source_ids": {"type": "array", "items": {"type": "string"}},
    "provider_observation_ids": {"type": "array", "items": {"type": "string"}},
    "entity_ids": {"type": "array", "items": {"type": "string"}},
    "thesis_ids": {"type": "array", "items": {"type": "string"}},
    "supporting_claims": {"type": "array", "items": {"type": "string"}},
    "date_of_evidence": {"type": "string"},
    "evidence_at": {"type": "string"},
    "event_horizon": {
      "type": "object",
      "description": "When the claim's underlying event resolves. Used by the mispricing-screen layer to pick the right options expiry.",
      "properties": {
        "event_date": {
          "type": "string",
          "description": "ISO date or YYYY-MM (month if only month known). Use when a specific date is known (earnings, FDA PDUFA, M&A close target, FOMC meeting)."
        },
        "horizon_bucket": {
          "type": "string",
          "enum": ["near_term_0_90d", "mid_term_90d_1y", "long_term_1y_3y", "structural_3y_plus"],
          "description": "Use when no specific date — coarse bucket of how soon the thesis pays off or fails."
        },
        "event_type": {
          "type": "string",
          "enum": [
            "earnings", "fda_decision", "fda_advisory_committee",
            "fomc", "rate_decision", "regulatory_docket",
            "ma_close", "ipo", "trial_readout", "data_release",
            "conference_launch", "product_launch",
            "budget_appropriation", "policy_decision",
            "industry_milestone", "structural"
          ],
          "description": "Type of event that resolves the claim."
        },
        "notes": {"type": "string"}
      }
    },
    "confidence": {"type": "number"},
    "status": {"type": "string", "enum": ["active", "under_review", "superseded"]},
    "visibility": {
      "type": "object",
      "required": ["classification", "strategy_leakage_risk"],
      "properties": {
        "classification": {
          "type": "string",
          "enum": ["private", "semi_private", "public_aggregate", "public_full"]
        },
        "strategy_leakage_risk": {"type": "string", "enum": ["low", "medium", "high"]},
        "publish_delay_days": {"type": "integer", "minimum": 0}
      }
    },
    "schema_version": {"type": "integer"}
  }
}
